# Configuración de TermSuite API

# Ruta al JAR de TermSuite
TERMSUITE_JAR=/app/termsuite/termsuite-core-3.0.10.jar

# Directorio de datos
DATA_DIR=/app/data

# Opciones de Java
JAVA_OPTS=-Xms1g -Xmx4g

# Puerto de la API
API_PORT=7000

# Configuración de Ollama para traducciones
OLLAMA_HOST=192.168.0.88
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:latest

# Optimizaciones de Ollama
OLLAMA_CACHE_ENABLED=true
OLLAMA_BATCH_SIZE=5
OLLAMA_TIMEOUT=30
OLLAMA_MAX_RETRIES=2
